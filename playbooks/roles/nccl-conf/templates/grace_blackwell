# Shape-wide benchmark defaults; collective/scale-specific tuning belongs in the job.
NCCL_DEBUG=WARN
NCCL_NET_PLUGIN={{ nccl_plugin_files.stdout }}
NCCL_SOCKET_IFNAME=eth0
NCCL_MNNVL_ENABLE=1
NCCL_CUMEM_ENABLE=1
NCCL_NVLS_ENABLE=1
NCCL_NET_GDR_C2C=1
{% if shape_nccl.content in ['BM.GPU.GB200.4', 'BM.GPU.GB200-v2.4'] %}
NCCL_IB_HCA==mlx5_0,mlx5_1,mlx5_3,mlx5_4
NCCL_IB_QPS_PER_CONNECTION=1
{% else %}
NCCL_IB_GID_INDEX=3
NCCL_IB_SL=0
NCCL_IB_SPLIT_DATA_ON_QPS=0
{% if nccl_multiplanar %}
NCCL_IB_HCA=rdma_vf_rail0,rdma_vf_rail1,rdma_vf_rail2,rdma_vf_rail3
NCCL_ASYNC_ERROR_HANDLING=1
NCCL_IB_TIMEOUT=16
NCCL_IB_RETRY_CNT=7
NCCL_IB_TC=96
NCCL_WORK_FIFO_BYTES=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_IB_ADAPTIVE_ROUTING=1
NCCL_TOPO_FILE=/opt/oci-hpc/healthchecks/GB300MP.xml
{% else %}
NCCL_IB_HCA==mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_5,mlx5_6,mlx5_7,mlx5_8
NCCL_IB_TC=41
NCCL_IB_TIMEOUT=22
NCCL_BUFFSIZE=16777216
NCCL_IB_QPS_PER_CONNECTION=4
NCCL_DMABUF_ENABLE=1
{% endif %}
{% endif %}
