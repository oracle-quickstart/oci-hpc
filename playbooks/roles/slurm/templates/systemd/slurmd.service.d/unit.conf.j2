
[Unit]
Requires=munge.service
After=munge.service network-online.target remote-fs.target sssd.service

[Service]
Restart=always
# Failed starts can leave slurmd outside systemd's tracked MAINPID.
ExecStartPre=-/usr/bin/pkill -KILL -x slurmd
ExecStopPost=-/usr/bin/pkill -KILL -x slurmd
ExecStart=
# Shortcut to set GPU resources:
# Gres=gpu:<short name>:<count>
# The short name will have to match (case-insensitive) at least a part of the
# official NVIDIA device name, with spaces replaced by underscores.
{% if shape == "BM.GPU2.2"%}
{% set gres = "Gres=gpu:P100:2" %}
{% elif shape == "VM.GPU2.1" %}
{% set gres = "Gres=gpu:P100:1" %}
{% elif shape == "VM.GPU3.1" %}
{% set gres = "Gres=gpu:V100:1" %}
{% elif shape == "VM.GPU3.2" %}
{% set gres = "Gres=gpu:V100:2" %}
{% elif shape == "VM.GPU3.4" %}
{% set gres = "Gres=gpu:V100:4" %}
{% elif shape == "BM.GPU3.8" %}
{% set gres = "Gres=gpu:V100:8" %}
{% elif shape == "BM.GPU4.8" %}
{% set gres = "Gres=gpu:A100:8" %}
{% elif shape == "BM.GPU.B4.8" %}
{% set gres = "Gres=gpu:A100:8" %}
{% elif shape == "BM.GPU.A100-v2.8" %}
{% set gres = "Gres=gpu:A100:8" %}
{% elif shape == "BM.GPU.H100.8" %}
{% set gres = "Gres=gpu:H100:8" %}
{% elif shape == "BM.GPU.H200.8" %}
{% set gres = "Gres=gpu:H200:8" %}
{% elif shape == "BM.GPU.B200.8" %}
{% set gres = "Gres=gpu:B200:8" %}
{% elif shape == "BM.GPU.GB200.4" %}
{% set gres = "Gres=gpu:B200:4" %}
{% elif shape == "BM.GPU.GB200-v2.4" %}
{% set gres = "Gres=gpu:B200:4" %}
{% elif shape == "BM.GPU.GB200-v3.4" %}
{% set gres = "Gres=gpu:B200:4" %}
{% elif shape == "BM.GPU.B300.8" %}
{% set gres = "Gres=gpu:B300:8" %}
{% elif shape == "BM.GPU.B300.HS.8" %}
{% set gres = "Gres=gpu:B300:8" %}
{% elif shape == "BM.GPU.GB300.4" %}
{% set gres = "Gres=gpu:B300:4" %}
{% elif shape == "BM.GPU.T1.2" %}
{% set gres = "Gres=gpu:A10:2" %}
{% elif shape == "BM.GPU.A10.4" %}
{% set gres = "Gres=gpu:A10:4" %}
{% elif shape == "VM.GPU.A10.2" %}
{% set gres = "Gres=gpu:A10:2" %}
{% elif shape == "VM.GPU.A10.1" %}
{% set gres = "Gres=gpu:A10:1" %}
{% elif shape == "BM.GPU.MI300X.8" %}
{% set gres = "Gres=gpu:MI300X:8" %}
{% elif shape in ["BM.GPU.MI355X.8", "BM.GPU.MI355X-v0.8", "BM.GPU.MI355X-v1.8"] %}
{% set gres = "Gres=gpu:MI355X:8" %}
{% elif shape == "BM.GPU.L40S-NC.4" %}
{% set gres = "Gres=gpu:L40S:4" %}
{% elif shape == "BM.GPU.RTXPRO.8" %}
{% set gres = "Gres=gpu:RTX_PRO:8" %}
{% elif shape in ["VM.GPU.A100.40G.1", "VM.GPU.A100.B40G.1", "VM.GPU.A100.80G.1"] %}
{% set gres = "Gres=gpu:A100:1" %}
{% elif shape in ["VM.GPU.A100.40G.2", "VM.GPU.A100.B40G.2", "VM.GPU.A100.80G.2"] %}
{% set gres = "Gres=gpu:A100:2" %}
{% elif shape in ["VM.GPU.A100.40G.4", "VM.GPU.A100.B40G.4", "VM.GPU.A100.80G.4"] %}
{% set gres = "Gres=gpu:A100:4" %}
{% else %}
{% set gres = "" %}
{% endif %}
{% set slurmd_conf = [] %}
{% if gres | trim %}
{% set _ = slurmd_conf.append(gres) %}
{% endif %}
{% set _ = slurmd_conf.append('Feature=' ~ instance_type ~ ',CN__' ~ cluster_name) %}
{% if slurm_node_topology is defined and slurm_node_topology | trim %}
{% set _ = slurmd_conf.append('Topology=' ~ slurm_node_topology) %}
{% endif %}
{% if not (permanent | bool) %}
ExecStart={{slurm_exec}}/sbin/slurmd --systemd --conf "{{ slurmd_conf | join(' ') }}" --conf-server {{ controller_hostname }}{% if (groups['slurm_backup']| length ) > 0 %},{{ slurm_backup_hostname }}{% endif %} $SLURMD_OPTIONS
{% else %}
ExecStart={{slurm_exec}}/sbin/slurmd --systemd -Z --conf "{{ slurmd_conf | join(' ') }}" --conf-server {{ controller_hostname }}{% if (groups['slurm_backup']| length ) > 0 %},{{ slurm_backup_hostname }}{% endif %} $SLURMD_OPTIONS
{% endif %}
