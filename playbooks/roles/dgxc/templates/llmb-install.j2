#!/usr/bin/env bash
set -euo pipefail

DGXC_REPO="${DGXC_REPO:-{{ dgxc_repo_path }}}"
DGXC_VENV="${DGXC_VENV:-{{ dgxc_venv_path }}}"
export LLMB_INSTALL="${LLMB_INSTALL:-{{ dgxc_install_path }}}"

_dgxc_mksquashfs_processors() {
  if [ -n "${DGXC_MKSQUASHFS_PROCESSORS:-}" ]; then
    printf '%s\n' "${DGXC_MKSQUASHFS_PROCESSORS}"
  elif command -v nproc >/dev/null 2>&1; then
    nproc --all
  else
    getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1\n'
  fi
}

case " ${ENROOT_SQUASH_OPTIONS:-} " in
  *" -processors "*) ;;
  "  ") export ENROOT_SQUASH_OPTIONS="{{ dgxc_enroot_squash_options }} -processors $(_dgxc_mksquashfs_processors)" ;;
  *) export ENROOT_SQUASH_OPTIONS="${ENROOT_SQUASH_OPTIONS} -processors $(_dgxc_mksquashfs_processors)" ;;
esac

export PATH="${DGXC_VENV}/bin:${LLMB_INSTALL}/bin:${PATH:-}"

cd "${DGXC_REPO}"
exec "${DGXC_VENV}/bin/llmb-install" "$@"
