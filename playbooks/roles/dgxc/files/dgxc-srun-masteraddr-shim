#!/usr/bin/env bash
set -euo pipefail

REAL_SRUN="${LLMB_REAL_SRUN:?LLMB_REAL_SRUN is not set}"
ARGS=("$@")

append_env_name() {
  local list="$1" name="$2"
  case ",${list}," in
    *",${name},"*) printf '%s' "${list}" ;;
    ",,") printf '%s' "${name}" ;;
    *) printf '%s,%s' "${list}" "${name}" ;;
  esac
}

is_container_step=0
for arg in "${ARGS[@]}"; do
  case "${arg}" in
    --container-image|--container-image=*|--container-env|--container-env=*)
      is_container_step=1
      break
      ;;
  esac
done

if [[ "${is_container_step}" -eq 0 || -z "${SLURM_JOB_NODELIST:-}" ]]; then
  exec "${REAL_SRUN}" "${ARGS[@]}"
fi

head_node="$(scontrol show hostnames "${SLURM_JOB_NODELIST}" | sed -n '1p')"
[[ -n "${head_node}" ]] || { echo "ERROR: unable to determine head node." >&2; exit 1; }

head_node_ip="$(
  "${REAL_SRUN}" --nodes=1 --ntasks=1 --nodelist="${head_node}" bash -lc '
    iface="${NCCL_SOCKET_IFNAME:-eth0}"
    iface="${iface%%,*}"
    iface="${iface#=}"
    ip -4 -o addr show dev "${iface}" 2>/dev/null |
      awk '\''{ split($4, address, "/"); print address[1]; exit }'\''
  ' | tail -n 1
)"

if [[ -z "${head_node_ip}" ]]; then
  head_node_ip="$(
    "${REAL_SRUN}" --nodes=1 --ntasks=1 --nodelist="${head_node}" hostname --ip-address |
      tr ' ' '\n' |
      awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $0 !~ /^127\./ { print; exit }'
  )"
fi

[[ -n "${head_node_ip}" ]] || { echo "ERROR: unable to determine IPv4 for ${head_node}." >&2; exit 1; }

export MASTER_ADDR="${head_node_ip}"
export MASTER_PORT=$((15000 + SLURM_JOB_ID % 10000))
echo "[llmb-masteraddr-shim] head_node=${head_node} MASTER_ADDR=${MASTER_ADDR} MASTER_PORT=${MASTER_PORT}" >&2

NEW_ARGS=()
found_container_env=0
for ((i = 0; i < ${#ARGS[@]}; i++)); do
  arg="${ARGS[i]}"
  case "${arg}" in
    --container-env)
      ((++i < ${#ARGS[@]})) || { echo "ERROR: --container-env has no value." >&2; exit 1; }
      env_list="$(append_env_name "${ARGS[i]}" MASTER_ADDR)"
      env_list="$(append_env_name "${env_list}" MASTER_PORT)"
      NEW_ARGS+=(--container-env "${env_list}")
      found_container_env=1
      ;;
    --container-env=*)
      env_list="$(append_env_name "${arg#--container-env=}" MASTER_ADDR)"
      env_list="$(append_env_name "${env_list}" MASTER_PORT)"
      NEW_ARGS+=("--container-env=${env_list}")
      found_container_env=1
      ;;
    *) NEW_ARGS+=("${arg}") ;;
  esac
done

if [[ "${found_container_env}" -eq 0 ]]; then
  env_list="$(append_env_name "${PYXIS_CONTAINER_ENV:-}" MASTER_ADDR)"
  env_list="$(append_env_name "${env_list}" MASTER_PORT)"
  NEW_ARGS+=("--container-env=${env_list}")
fi

exec "${REAL_SRUN}" "${NEW_ARGS[@]}"
